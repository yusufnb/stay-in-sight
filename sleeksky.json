{
  "id": "stay-in-sight",
  "name": "Stay in Sight",
  "home": "/",
  "resources": {
    "d1": {
      "binding": "DB"
    },
    "durable_objects": [
      {
        "binding": "SCHEDULER",
        "class": "Scheduler"
      }
    ]
  },
  "schedules": [
    {
      "every": "15m",
      "path": "/_platform/tick"
    }
  ],
  "platform_signin": true,
  "signin_path": "/auth/platform",
  "egress": "any",
  "payments": "none",
  "products": [
    {
      "id": "stay-in-sight",
      "name": "Stay in Sight",
      "description": "Scheduled outbound email from your own Gmail or SES mailboxes: lists, templates, drip series, warm-up, reply tracking with AI categories, and an API and MCP server.",
      "icon": "rocket",
      "color": "teal",
      "replaces": [
        "Mailshake",
        "Lemlist",
        "Mailchimp"
      ],
      "variants": [
        {
          "id": "stay-in-sight-outbound",
          "name": "Outbound",
          "price": 19
        }
      ]
    }
  ],
  "release": {
    "config": "wrangler.toml"
  }
}
