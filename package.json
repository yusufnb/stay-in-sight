{
  "name": "@sleekcms/cms-outbound",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Outbound email scheduler on Cloudflare Workers + D1 (Gmail, replies, opens, do-not-send, MCP)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy:tenant": "node scripts/deploy-tenant.mjs"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "hono": "^4.6.0",
    "postal-mime": "^4.2.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@cloudflare/workers-types": "^4.20241022.0",
    "selfsigned": "^5.5.0",
    "smol-toml": "^1.9.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1",
    "wrangler": "^4.0.0"
  }
}
