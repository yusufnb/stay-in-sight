# One file per tenant: tenants/<tenant>.env  ->  npm run deploy:tenant -- <tenant>
# Real tenant files are gitignored; only this example is committed.

# --- Deployment ---
# Worker and D1 database names (lowercase, dashes). Defaults: cms-outbound-<tenant>.
WORKER_NAME=cms-outbound-acme
D1_DATABASE=cms-outbound-acme

# --- Settings (Worker vars) ---
# Leave PUBLIC_URL empty on the first deploy: the script detects the workers.dev URL and tells you what to put here.
PUBLIC_URL=
# projects/<project-id>/topics/<topic> once Gmail Pub/Sub is set up (see DEPLOY.md, Part 3)
GMAIL_PUBSUB_TOPIC=
SEND_BATCH=20
OPENROUTER_MODEL=openai/gpt-6-luna

# --- Secrets ---
# Uploaded on every deploy. Leave a value empty to keep whatever is already set on the Worker.
# PASSCODE: at least 12 characters, e.g. from `openssl rand -base64 24`
PASSCODE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENROUTER_API_KEY=
